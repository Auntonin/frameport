!/.gitattributes
!/README.md
!/SECURITY.md
!/LICENSE
!/requirements.txt
!/requirements-build.txt
!/setup.ps1
!/start.cmd
!/app.py
!/build-release.ps1
!/package-release.py
!/importer/
!/tests/
!/profiles/
!/assets/
!/tools/
!/scripts/
!/docs/
!/.github/

**/__pycache__/
*.py[cod]
.venv*/
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.sqlite*
*.db
*.log
*.xlsx
*.xls
*.csv
*.jpg
*.jpeg
*.webp
*.png
